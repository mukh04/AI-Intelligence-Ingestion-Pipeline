# Put your Gemini API key here. Never commit .env to GitHub.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional fallbacks. Leave blank if you do not have these keys.
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Collection settings
MAX_ARXIV_RESULTS=1000
REQUEST_CONCURRENCY=8
REQUEST_TIMEOUT=25
